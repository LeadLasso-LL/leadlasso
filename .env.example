# Server
PORT=3000
NODE_ENV=development
# Comma-separated extra CORS origins (default allows https://getjuvo.io and https://www.getjuvo.io)
# CORS_ORIGINS=http://localhost:5173,https://staging.example.com

# Twilio — one webhook URL per event type; business is identified by the number that received the event
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public URL where Twilio can reach this server (e.g. https://xxx.ngrok.io)
TWILIO_WEBHOOK_BASE_URL=

# Retell AI — webhook signature verification (API key with webhook badge)
RETELL_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key (browser) — used only to inject into /portal; never use as server secret
SUPABASE_ANON_KEY=

# Public origin for portal + password-setup redirects (no trailing slash), e.g. https://getjuvo.io
PORTAL_PUBLIC_ORIGIN=

# Resend — transactional email
RESEND_API_KEY=
FROM_EMAIL=Juvo <hello@getjuvo.io>

# Support chat — escalation alerts to Juvo team
SUPPORT_PHONE=
TWILIO_SUPPORT_FROM=
ANTHROPIC_API_KEY=
